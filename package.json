{
  "name": "omp-web",
  "version": "0.1.4",
  "description": "Web view for the omp (oh-my-pi) coding agent CLI",
  "homepage": "https://github.com/ddallabenetta/omp-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddallabenetta/omp-web.git"
  },
  "bugs": {
    "url": "https://github.com/ddallabenetta/omp-web/issues"
  },
  "keywords": [
    "omp",
    "oh-my-pi",
    "coding-agent",
    "web-ui"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0",
    "bun": ">=1.2.0"
  },
  "bin": {
    "omp-web": "bin/omp-web.js"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "public",
    "next.config.ts",
    "package.json"
  ],
  "scripts": {
    "dev": "bun --bun next dev --webpack -H 127.0.0.1 -p 30141",
    "dev:lan": "bun --bun next dev --webpack -H 0.0.0.0 -p 30141",
    "build": "bun --bun next build --webpack",
    "start": "bun --bun next start -H 127.0.0.1 -p 30141",
    "start:lan": "bun --bun next start -H 0.0.0.0 -p 30141",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "release": "npm version patch --no-git-tag-version && npm run build && npm publish --access public"
  },
  "dependencies": {
    "@oh-my-pi/pi-agent-core": "~17.2.4",
    "@oh-my-pi/pi-ai": "~17.2.4",
    "@oh-my-pi/pi-coding-agent": "~17.2.4",
    "@oh-my-pi/pi-tui": "~17.2.4",
    "@oh-my-pi/pi-utils": "~17.2.4",
    "next": "16.2.12",
    "proper-lockfile": "4.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "undici": "8.5.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@lobehub/icons": "^5.15.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.5",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "jiti": "^2.7.0",
    "katex": "^0.16.47",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.0",
    "postcss": "^8.5.25",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
