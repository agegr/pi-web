<?xml version='1.0' encoding='utf-8'?>
<!--
  Cordova compatibility manifest for the pi-web iOS shell (pi#31).
  Intentionally minimal: the pi-web shell uses no Cordova plugins, so the only
  meaningful declaration is the default permissive access (the WKWebView's
  navigations are governed by Capacitor's own configuration — see
  ../capacitor.config.json and ../../capacitor.config.ts, regenerated by
  `npx cap sync ios`). Plugin configuration (Keyboard resize mode, Local
  Notifications) lives in capacitor.config.ts, not here.
-->
<widget version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <access origin="*" />
</widget>
