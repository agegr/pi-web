# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# pi-web runtime artifacts (written by bin/pi-web.js and the runtime modules)
/.pi-web-hostname
/.pi-web-runtime-password
/.pi-web-pair-tokens.json
/package.json.tmp
next-env.d.ts
.factory

# Local security audit output. These contain raw findings (vulnerability
# descriptions, affected file paths, sometimes exploit snippets) that
# would expose the project's open attack surface if pushed to a public
# repo. Always keep them out of version control.
.codex-security-artifacts/